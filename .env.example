# ---- Server ----
NODE_ENV=development
SERVER_HOST=0.0.0.0
SERVER_PORT=4000

# Postgres
DATABASE_URL=postgres://fitnessapp:fitnessapp@localhost:5432/fitnessapp
POSTGRES_USER=fitnessapp
POSTGRES_PASSWORD=fitnessapp
POSTGRES_DB=fitnessapp

# Auth
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
BCRYPT_COST=12

# CORS allowlist (comma-separated)
CORS_ORIGINS=http://localhost:19006,http://localhost:8081

# ---- Mobile (Expo) ----
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_SOCKET_URL=http://localhost:4000
EXPO_PUBLIC_DEFAULT_LOCALE=he

# ---- Full Docker Compose stack ----
# Browser-visible endpoints baked into the Expo web image.
PUBLIC_API_URL=http://localhost:4000
PUBLIC_SOCKET_URL=http://localhost:4000
API_PORT=4000
WEB_PORT=8081
POSTGRES_PORT=5432
ADMINER_PORT=8080
