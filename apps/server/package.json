{
  "name": "@fitnessapp/server",
  "version": "0.1.0",
  "private": true,
  "description": "FitnessApp backend — Fastify + Postgres + Socket.IO.",
  "license": "MIT",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "migrate": "node --import tsx src/db/migrate.ts",
    "seed": "node --import tsx src/db/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "10.0.1",
    "@fastify/helmet": "12.0.1",
    "@fastify/rate-limit": "10.1.1",
    "@fastify/sensible": "6.0.1",
    "bcrypt": "5.1.1",
    "dotenv": "16.4.5",
    "fastify": "5.0.0",
    "jsonwebtoken": "9.0.2",
    "kysely": "0.27.4",
    "pg": "8.13.0",
    "pino": "9.4.0",
    "socket.io": "4.8.0",
    "zod": "3.23.8",
    "@fitnessapp/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/bcrypt": "5.0.2",
    "@types/jest": "29.5.13",
    "@types/jsonwebtoken": "9.0.7",
    "@types/node": "20.16.10",
    "@types/pg": "8.11.10",
    "@types/supertest": "6.0.2",
    "eslint": "9.12.0",
    "jest": "29.7.0",
    "socket.io-client": "4.8.0",
    "supertest": "7.0.0",
    "ts-jest": "29.2.5",
    "tsx": "4.19.1",
    "typescript": "5.6.3"
  }
}
