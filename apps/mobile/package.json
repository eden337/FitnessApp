    "i18next": "23.15.1",
    "mobx": "6.13.3",
    "mobx-react-lite": "4.0.7",
    "react": "18.2.0",
    "react-i18next": "15.0.2",
    "react-native": "0.74.5",
    "socket.io-client": "4.8.0",
    "zod": "3.23.8"
